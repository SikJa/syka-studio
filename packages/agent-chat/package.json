{
  "name": "@diffusionstudio/agent-chat",
  "version": "0.1.0",
  "description": "The editor's agent chat: a Node host that drives the user's Claude Code or Codex against a project over a WebSocket, and the browser-safe protocol, client and reducer the UI is a view over. Node code lives behind the `./host` export.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host/index.ts",
    "./host/env": "./src/host/env.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "agent",
    "chat",
    "claude-code",
    "codex"
  ],
  "dependencies": {
    "@diffusionstudio/dapi": "*",
    "playwright-core": "1.63.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
